ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://reviewbot:change-me@postgres:5432/reviewbot
POSTGRES_PASSWORD=change-me
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_HOST_PATH=
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_BOT_LOGIN=your-review-bot[bot]
GITHUB_APP_DISPLAY_NAME=Your Review Bot
GITHUB_API_URL=https://api.github.com
ALLOWED_GITHUB_ACCOUNTS=inryeok-office
ALLOW_UNLISTED_GITHUB_ACCOUNTS=false
CODEX_EXECUTOR_URL=unix:///run/inryeok-bot/executor.sock
WORK_ROOT=/var/lib/review-bot/work
REVIEW_TIMEOUT_SECONDS=900
GIT_TIMEOUT_SECONDS=60
MAX_CHANGED_FILES=200
MAX_FILE_BYTES=1000000
MAX_DIFF_BYTES=5000000
MAX_WEBHOOK_BODY_BYTES=2000000
MIN_WORK_FREE_BYTES=100000000
DEFAULT_MIN_CONFIDENCE=0.90
DEFAULT_MAX_FINDINGS=10
DEFAULT_INCLUDE_LOW_SEVERITY=false
DEFAULT_IGNORE_DRAFT=true
DEFAULT_IGNORE_PATTERNS=generated/**,**/generated/**,build/**,**/build/**,dist/**,**/dist/**,*.lock,**/*.lock,package-lock.json,**/package-lock.json
ADMIN_SESSION_SECRET=
ADMIN_GITHUB_CLIENT_ID=
ADMIN_GITHUB_CLIENT_SECRET=
ADMIN_LOCAL_BYPASS=false
CODEX_MODEL_ALLOWLIST=
MAX_PENDING_JOBS=100
MAX_REPOSITORY_PENDING_JOBS=10
DEFAULT_REVIEW_LANGUAGE=ko
DEFAULT_REVIEW_PROFILE=BALANCED
DOMAIN=localhost
