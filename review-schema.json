{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": {"type": "string", "maxLength": 10000},
    "findings": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scope", "path", "line", "side", "category", "severity", "confidence", "title", "body", "condition", "impact", "evidence", "suggested_fix", "domain"],
        "properties": {
          "scope": {"type": "string", "enum": ["LINE", "FILE", "PR"]},
          "path": {"type": ["string", "null"], "maxLength": 1024},
          "line": {"type": ["integer", "null"], "minimum": 1},
          "side": {"type": ["string", "null"], "enum": ["RIGHT", null]},
          "category": {"type": "string", "enum": ["BUG", "CORRECTNESS", "BEHAVIOR", "REGRESSION", "SECURITY", "DATA_INTEGRITY", "TRANSACTION", "CONCURRENCY", "NULL_SAFETY", "ERROR_HANDLING", "API_CONTRACT", "PERFORMANCE", "RESOURCE_LEAK", "TESTING", "SIMPLIFICATION"]},
          "severity": {"type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "title": {"type": "string", "minLength": 1, "maxLength": 300},
          "body": {"type": "string", "minLength": 1, "maxLength": 4000},
          "condition": {"type": ["string", "null"], "maxLength": 1000},
          "impact": {"type": ["string", "null"], "maxLength": 1000},
          "evidence": {"type": ["string", "null"], "maxLength": 1200},
          "suggested_fix": {"type": ["string", "null"], "maxLength": 1200},
          "domain": {"type": ["string", "null"], "maxLength": 64}
        }
      }
    }
  }
}
