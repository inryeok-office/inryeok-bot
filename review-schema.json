{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": {"type": "string", "maxLength": 10000},
    "findings": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "findingCommon": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "category", "severity", "confidence", "title", "body"],
      "properties": {
        "scope": {"enum": ["LINE", "FILE", "PR"]},
        "path": {"type": ["string", "null"], "maxLength": 1024},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "side": {"type": ["string", "null"], "enum": ["RIGHT", null]},
        "category": {"enum": ["BUG", "CORRECTNESS", "BEHAVIOR", "REGRESSION", "SECURITY", "DATA_INTEGRITY", "TRANSACTION", "CONCURRENCY", "NULL_SAFETY", "ERROR_HANDLING", "API_CONTRACT", "PERFORMANCE", "RESOURCE_LEAK", "TESTING", "SIMPLIFICATION"]},
        "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "body": {"type": "string", "minLength": 1, "maxLength": 4000},
        "condition": {"type": "string", "minLength": 1, "maxLength": 1000},
        "impact": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 1200},
        "suggested_fix": {"type": "string", "minLength": 1, "maxLength": 1200},
        "domain": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "finding": {
      "oneOf": [
        {"allOf": [{"$ref": "#/$defs/findingCommon"}, {"required": ["scope", "path", "line", "side"], "properties": {"scope": {"const": "LINE"}, "path": {"type": "string", "minLength": 1, "maxLength": 1024}, "line": {"type": "integer", "minimum": 1}, "side": {"const": "RIGHT"}}}]},
        {"allOf": [{"$ref": "#/$defs/findingCommon"}, {"required": ["scope", "path"], "properties": {"scope": {"const": "FILE"}, "path": {"type": "string", "minLength": 1, "maxLength": 1024}, "line": {"type": "null"}, "side": {"type": "null"}}}]},
        {"allOf": [{"$ref": "#/$defs/findingCommon"}, {"required": ["scope"], "properties": {"scope": {"const": "PR"}, "path": {"type": ["string", "null"], "maxLength": 1024}, "line": {"type": "null"}, "side": {"type": "null"}}}]}
      ]
    }
  }
}
